generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RuleType {
  ELIGIBILITY
  EXCLUSION
  REVIEW_TRIGGER
}
enum VerificationStatus {
  NEEDS_REVIEW
  VERIFIED
  REJECTED
}
enum SimulationMode {
  STRESS_TEST
  BOUNDARY_SCAN
  FAIRNESS_AUDIT
}
enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}
enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum Outcome {
  ELIGIBLE
  REJECTED
  NEEDS_REVIEW
}

model Policy {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    PolicyVersion[]

  @@index([slug])
}

model PolicyVersion {
  id           String       @id @default(uuid()) @db.Uuid
  policyId     String       @db.Uuid
  version      Int
  /// PolicyModel JSON: variables, parameters, budget assumptions, fairness config, simulation config
  model        Json
  sourceText   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  policy       Policy       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  rules        Rule[]
  simulations  Simulation[]

  @@unique([policyId, version])
  @@index([policyId])
}

model Rule {
  id                   String             @id @default(uuid()) @db.Uuid
  policyVersionId      String             @db.Uuid
  ruleCode             String
  description          String
  type                 RuleType
  /// { variable, operator, value }
  normalizedConstraint Json
  confidence           Float              @default(1)
  sourceText           String?
  verificationStatus   VerificationStatus @default(NEEDS_REVIEW)
  enabled              Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  policyVersion        PolicyVersion      @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, ruleCode])
  @@index([policyVersionId])
}

model Job {
  id           String      @id @default(uuid()) @db.Uuid
  type         String
  status       JobStatus   @default(QUEUED)
  progress     Float       @default(0)
  stage        String?
  error        String?
  payload      Json?
  createdAt    DateTime    @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  simulation   Simulation?

  @@index([status])
}

model Simulation {
  id              String            @id @default(uuid()) @db.Uuid
  policyVersionId String            @db.Uuid
  jobId           String?           @unique @db.Uuid
  status          JobStatus         @default(QUEUED)
  mode            SimulationMode
  seed            Int
  populationSize  Int
  configHash      String?
  createdAt       DateTime          @default(now())
  completedAt     DateTime?
  policyVersion   PolicyVersion     @relation(fields: [policyVersionId], references: [id])
  job             Job?              @relation(fields: [jobId], references: [id])
  result          SimulationResult?
  whatIfRuns      WhatIfRun[]
  reports         Report[]

  @@index([status])
  @@index([policyVersionId])
}

model SimulationResult {
  id                 String          @id @default(uuid()) @db.Uuid
  simulationId       String          @unique @db.Uuid
  dataType           String          @default("SYNTHETIC")
  resultHash         String
  activeRuleCodes    String[]
  ignoredRules       Json
  counts             Json
  rejectionReasons   Json
  /// FairnessAnalysis JSON (synthetic aggregates only)
  fairness           Json
  edgeCaseCounts     Json
  createdAt          DateTime        @default(now())
  simulation         Simulation      @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  edgeCases          EdgeCase[]
  cliffs             PolicyCliff[]
  conflicts          RuleConflict[]
  cases              SyntheticCase[]
}

model SyntheticCase {
  id           String           @id @default(uuid()) @db.Uuid
  resultId     String           @db.Uuid
  caseId       String
  attributes   Json
  outcome      Outcome
  synthetic    Boolean          @default(true)
  result       SimulationResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, caseId])
  @@index([resultId, outcome])
}

model EdgeCase {
  id             String           @id @default(uuid()) @db.Uuid
  resultId       String           @db.Uuid
  simulationId   String           @db.Uuid
  caseId         String
  type           String
  types          String[]
  severity       Severity
  attributes     Json
  result         Outcome
  reason         String
  triggeredRules String[]
  violatedRules  String[]
  nearThresholds Json
  synthetic      Boolean          @default(true)
  simResult      SimulationResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([simulationId])
  @@index([type])
  @@index([severity])
  @@index([simulationId, type, severity])
}

model PolicyCliff {
  id            String           @id @default(uuid()) @db.Uuid
  resultId      String           @db.Uuid
  ruleCode      String
  variable      String
  threshold     Float
  beforeValue   Float
  afterValue    Float
  outcomeBefore Outcome
  outcomeAfter  Outcome
  delta         Float
  affectedCases Int
  exposedCases  Int
  severity      Severity
  simResult     SimulationResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
}

model RuleConflict {
  id            String           @id @default(uuid()) @db.Uuid
  resultId      String           @db.Uuid
  ruleA         String
  ruleB         String?
  conflictType  String
  description   String
  affectedCases Int
  severity      Severity
  simResult     SimulationResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
}

model WhatIfRun {
  id           String     @id @default(uuid()) @db.Uuid
  simulationId String     @db.Uuid
  parameter    String
  oldValue     Float
  newValue     Float
  seed         Int
  result       Json
  createdAt    DateTime   @default(now())
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId])
}

model Report {
  id           String     @id @default(uuid()) @db.Uuid
  simulationId String     @db.Uuid
  whatIfRunIds String[]
  filePath     String?
  byteSize     Int?
  createdAt    DateTime   @default(now())
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId])
}
