{
  "name": "edgecase-backend",
  "version": "0.1.0",
  "private": true,
  "description": "EDGECASE backend - deterministic policy simulation engine (phase 1: engine + schema)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "zod": "^4.6.5"
  }
}
