PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# AI provider:
# mock -> offline
# anthropic -> needs key
# gemini -> needs key
AI_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

DEMO_MODE=false

MAX_POPULATION_SIZE=100000
MAX_UPLOAD_SIZE_MB=10