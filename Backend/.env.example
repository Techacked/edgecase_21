PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# AI provider for rule extraction, what-if explanations and chat:
#   mock       -> fully offline, deterministic (default, no key needed)
#   anthropic  -> needs ANTHROPIC_API_KEY
#   gemini     -> needs GEMINI_API_KEY
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Force the offline engine even if a key is configured
DEMO_MODE=false

MAX_POPULATION_SIZE=100000
MAX_UPLOAD_SIZE_MB=10
